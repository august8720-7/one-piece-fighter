{
  "name": "one-piece-fighter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based One Piece 1v1 fighting game (KOF-style). Luffy vs Akainu.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
