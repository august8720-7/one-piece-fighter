  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.5.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
